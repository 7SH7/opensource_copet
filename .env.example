# forensicagent 환경변수. 이 파일을 `.env` 로 복사한 뒤 값만 채우면 됩니다.
# (`.env` 는 .gitignore 에 등록되어 있습니다.)
#
# Resolution: 실제 shell env > .env > config.py 의 기본값
# FORENSICAGENT_* 경로 설정의 상대경로는 PROJECT_ROOT 기준으로 해석됩니다.
# 아래 HF_* 변수는 외부 라이브러리가 CWD 기준으로 해석하므로 절대경로를 쓰세요.

# ---------------------------------------------------------------------------
# 경로
# ---------------------------------------------------------------------------

# 사용자 상태 루트 (tools/, chroma/, tools_bin/ 의 부모).
# 기본값: ~/.forensicagent
FORENSICAGENT_HOME=.forensicagent

# 도구 메타데이터 YAML 폴더.
# 기본값: $FORENSICAGENT_HOME/tools
FORENSICAGENT_TOOLS_DIR=tools_metadata

# ChromaDB persist 디렉토리.
# 기본값: $FORENSICAGENT_HOME/chroma
FORENSICAGENT_CHROMA_DIR=.forensicagent/chroma

# Hugging Face 캐시를 증거 폴더에 만들지 않도록 프로젝트 내부 절대경로를 사용합니다.
# HF_HOME=C:\path\to\forensicagent\.cache\huggingface
# SENTENCE_TRANSFORMERS_HOME=C:\path\to\forensicagent\.cache\sentence-transformers

# 크롤 산출물 (rag.indexer 의 입력) 루트.
# 기본값: $PROJECT_ROOT/seed_docs
# FORENSICAGENT_SEED_DOCS_DIR=seed_docs

# 도구 출력 + 리포트 저장 위치.
# 이 값을 지정하면 모든 케이스가 이 폴더 아래로 모입니다.
# 비워두면 (기본) ~/.forensicagent/output/<case>_<path-hash>/ 아래에 저장되어
# 원본 증거 트리를 변경하지 않습니다.
# FORENSICAGENT_OUTPUT_DIR=forensicagent_output

# ---------------------------------------------------------------------------
# LLM (Ollama)
# ---------------------------------------------------------------------------

# FORENSICAGENT_LLM_BASE_URL=http://localhost:11434
# FORENSICAGENT_LLM_MODEL=qwen2.5:7b
# FORENSICAGENT_LLM_TEMPERATURE=0.1
# FORENSICAGENT_LLM_HEALTH_TIMEOUT_SEC=5
# FORENSICAGENT_LLM_REQUEST_TIMEOUT_SEC=300

# ---------------------------------------------------------------------------
# 실행 제어
# ---------------------------------------------------------------------------

# FORENSICAGENT_TIMEOUT_SEC=300
# FORENSICAGENT_MAX_PARALLEL=3
# FORENSICAGENT_MAX_JOB_OUTPUT_BYTES=536870912
# FORENSICAGENT_MAX_TOTAL_OUTPUT_BYTES=2147483648
# FORENSICAGENT_MIN_FREE_DISK_BYTES=536870912

# ---------------------------------------------------------------------------
# 임베딩 / Chroma 컬렉션 / API 키
# ---------------------------------------------------------------------------

# FORENSICAGENT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# FORENSICAGENT_COLLECTION=forensic_tools
# FORENSICAGENT_TOOL_COLLECTION=forensic_tool_meta
# FORENSICAGENT_USE_RAG=true
# FORENSICAGENT_RAG_TOP_K=5
# FORENSICAGENT_RAG_MIN_SIMILARITY=0.25
# FORENSICAGENT_RAG_MIN_SCORE_MARGIN=0.10
# OPENAI_API_KEY=
# OpenAI embedding 사용 시:
# .\.venv\Scripts\python.exe -m pip install -e ".[rag,openai]"
# FORENSICAGENT_EMBEDDING_MODEL=openai:text-embedding-3-small

# RDP off-hours heuristic (기본값은 UTC 07:00-20:00).
# 아래는 한국 조직의 KST 09:00-18:00 override 예시입니다.
# FORENSICAGENT_RDP_UTC_OFFSET_MINUTES=540
# FORENSICAGENT_RDP_BUSINESS_START_HOUR=9
# FORENSICAGENT_RDP_BUSINESS_END_HOUR=18

# ---------------------------------------------------------------------------
# .env 위치 자체 오버라이드 (사용 드묾)
# ---------------------------------------------------------------------------

# FORENSICAGENT_DOTENV=.env.local
